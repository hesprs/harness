{
	"colorSources": {
		"starship": "terminal",
		"editor": "terminal",
		"userMessages": "terminal"
	},
	"features": {
		"statusLine": true,
		"editor": true
	},
	"fixedEditor": {
		"enabled": false
	},
	"components": {
		"editor": {
			"enabled": true,
			"style": "minimalist",
			"colorSource": "theme",
			"borderColorMode": "static",
			"modelLabel": "name",
			"viewportIndicators": true,
			"styles": {
				"opencode": {
					"metadataFormat": "$model  $provider(  $thinking)",
					"completionMenu": "palette"
				},
				"opencode-copy-friendly": {
					"metadataFormat": "$model  $provider(  $thinking)",
					"completionMenu": "palette"
				},
				"accent-rail": {
					"rail": "▎",
					"asciiRail": "|",
					"transparent": false
				},
				"minimalist": {
					"pathDisplay": "compact",
					"contextFormat": "percent-total",
					"contextGauge": false,
					"showSessionName": false,
					"showTimer": false,
					"showCost": false,
					"showGit": false,
					"contextThresholds": {
						"warning": 70,
						"error": 90
					}
				}
			}
		},
		"userMessages": {
			"enabled": true,
			"style": "labeled",
			"colorSource": "theme",
			"styles": {
				"framed": {},
				"framed-copy-friendly": {},
				"compact": {},
				"labeled": {}
			}
		},
		"workingLine": {
			"enabled": true,
			"turnSummary": true,
			"spinner": "pulse",
			"spinnerIntervalMs": 100,
			"animateSpinnerColor": false,
			"textIntervalMs": 60,
			"textAnimation": "classic",
			"colorSource": "theme",
			"messages": {
				"custom": true,
				"values": [
					"Sautéing…",
					"Cooking…",
					"Ionizing…",
					"Zigzagging…",
					"Razzle-dazzling…",
					"Photosynthesizing…",
					"Nucleating…",
					"Brewing…",
					"Combobulating…",
					"Boogieing…",
					"Befuddling…",
					"Alchemizing…",
					"Conjuring…",
					"Baking…",
					"Simmering…",
					"Blanching…"
				]
			},
			"segments": {
				"tool": true,
				"elapsed": true,
				"thought": true,
				"tokens": true
			}
		},
		"selectorBorders": {
			"enabled": true,
			"style": "zentui",
			"colorSource": "theme"
		},
		"footer": {
			"style": "starship",
			"colorSource": "theme",
			"modelLabel": "name",
			"styles": {
				"starship": {
					"format": "",
					"responsive": true,
					"compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
					"compactMaxLines": 2,
					"separator": "pipe",
					"contextStyle": "text",
					"contextThresholds": {
						"warning": 70,
						"error": 90
					},
					"pathDisplay": {
						"mode": "basename",
						"depth": 0
					},
					"segments": {
						"cwd": false,
						"sessionName": false,
						"gitBranch": true,
						"gitStatus": false,
						"gitCounts": false,
						"gitCommit": false,
						"gitMetrics": true,
						"runtime": true,
						"modelInfo": false,
						"context": false,
						"tokens": true,
						"cost": true,
						"sessionDuration": false,
						"username": false,
						"time": false,
						"os": false,
						"packageVersion": false
					},
					"gitBranch": {
						"maxLength": "full"
					},
					"gitCommit": {
						"hashLength": 7,
						"onlyDetached": true,
						"showTag": true
					},
					"gitMetrics": {
						"onlyNonzero": true,
						"ignoreSubmodules": false
					},
					"extensionStatuses": {
						"defaultPlacement": "right",
						"placements": {},
						"colorModes": {
							"harness": "zentui"
						}
					}
				}
			}
		}
	},
	"icons": {
		"mode": "auto"
	}
}
